# ── Required ───────────────────────────────────────────────────────────────────
# The only key needed to run in paper trading mode
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Binance (only needed for live order placement) ─────────────────────────────
# Leave blank to use paper trading with real Binance market data
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Bot behaviour ──────────────────────────────────────────────────────────────
PAPER_TRADING=true           # true = log decisions only, no real orders sent
PAPER_BALANCE_USDT=10000     # simulated portfolio size for paper trading
KILL_SWITCH=false            # true = halt all new positions immediately

# ── Symbols ────────────────────────────────────────────────────────────────────
TRACKED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# ── AI model ───────────────────────────────────────────────────────────────────
MODEL_NAME=claude-sonnet-4-6

# ── Risk parameters ────────────────────────────────────────────────────────────
MIN_CONFIDENCE=0.7           # minimum Claude confidence to act (0.0–1.0)
MAX_POSITION_PCT=20          # max % of portfolio per asset
MAX_TOTAL_EXPOSURE_PCT=60    # max % of portfolio across all open positions
STOP_LOSS_PCT=5              # stop-loss trigger in % below entry price
TAKE_PROFIT_PCT=0            # take-profit trigger in % above entry (0 = disabled)

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./crypto_bot.db
