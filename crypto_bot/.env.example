# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Phemex (testnet keys by default — swap for live keys when PHEMEX_LIVE=true)
PHEMEX_API_KEY=your_phemex_api_key_here
PHEMEX_API_SECRET=your_phemex_api_secret_here

# Set to "true" to trade on live Phemex (default: testnet)
PHEMEX_LIVE=false

# CryptoPanic
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# Twitter / X API v2
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit PRAW
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=crypto_bot/1.0 by /u/your_reddit_username

# Bot behaviour
PAPER_TRADING=true          # true = log decisions only, no real orders
KILL_SWITCH=false           # true = halt all new positions immediately
MIN_CONFIDENCE=0.7          # minimum Claude confidence to act (0.0–1.0)
MAX_POSITION_PCT=20         # max % of portfolio per asset
MAX_TOTAL_EXPOSURE_PCT=60   # max % of portfolio in open positions
STOP_LOSS_PCT=5             # stop-loss trigger in % below entry
