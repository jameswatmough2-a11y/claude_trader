# ── Required ──────────────────────────────────────────────────────────────────
# The only key needed to run the bot in paper trading mode
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Binance (only needed for live order placement) ────────────────────────────
# Leave blank to run in paper trading mode with real Binance market data
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Bot behaviour ─────────────────────────────────────────────────────────────
PAPER_TRADING=true          # true = log decisions only, no real orders
PAPER_BALANCE_USDT=10000    # simulated portfolio size for paper trading
KILL_SWITCH=false           # true = halt all new positions immediately
MIN_CONFIDENCE=0.7          # minimum Claude confidence to act (0.0–1.0)
MAX_POSITION_PCT=20         # max % of portfolio per asset
MAX_TOTAL_EXPOSURE_PCT=60   # max % of portfolio in open positions
STOP_LOSS_PCT=5             # stop-loss trigger in % below entry
